{
  "name": "react-native-nitro-device-info-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for react-native-nitro-device-info",
  "scripts": {
    "showcase": "yarn workspace react-native-nitro-device-info-example",
    "benchmark": "yarn workspace react-native-nitro-device-info-benchmark",
    "integrity-demo": "yarn workspace react-native-nitro-device-integrity-demo",
    "pod:showcase": "cd example/showcase/ios && pod install",
    "pod:benchmark": "cd example/benchmark/ios && pod install",
    "pod:integrity-demo": "cd example/integrity-demo/ios && pod install",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:eslint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli packages/react-native-nitro-device-info/lib packages/react-native-nitro-device-info/nitrogen/generated packages/react-native-nitro-device-info/android/build example/showcase/android/build example/showcase/android/app/build example/showcase/ios/build example/benchmark/android/build example/benchmark/android/app/build example/benchmark/ios/build",
    "prepare": "yarn workspace react-native-nitro-device-info prepare",
    "nitrogen": "yarn workspace react-native-nitro-device-info nitrogen",
    "nitrogen:integrity": "yarn workspace react-native-nitro-device-integrity nitrogen",
    "test:security": "node --test scripts/security-regressions.cjs",
    "test:web": "node --test scripts/web-package-regressions.cjs",
    "changeset": "changeset",
    "version-packages": "changeset version && yarn install --mode update-lockfile",
    "release:prepare": "node scripts/release.cjs prepare",
    "release:verify": "node scripts/release.cjs verify",
    "release:publish": "node scripts/release.cjs publish",
    "test:release": "node --test scripts/release.test.cjs scripts/check-package.test.cjs",
    "test:integrity": "node --test packages/react-native-nitro-device-integrity/__tests__/regressions.cjs",
    "test:integrity:native": "node --test packages/react-native-nitro-device-integrity/__tests__/native-regressions.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l2hyunwoo/react-native-nitro-device-info.git"
  },
  "author": "HyunWoo Lee <l2hyunwoo@gmail.com> (https://github.com/l2hyunwoo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/l2hyunwoo/react-native-nitro-device-info/issues"
  },
  "homepage": "https://github.com/l2hyunwoo/react-native-nitro-device-info#readme",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@evilmartians/lefthook": "2.1.9",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "braces": "^3.0.3",
    "commitlint": "21.0.2",
    "del-cli": "7.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "http-cache-semantics": "4.3.0",
    "jest": "29.7.0",
    "nitrogen": "0.35.9",
    "oxlint": "1.57.0",
    "prettier": "3.8.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "0.41.0",
    "react-native-nitro-modules": "0.35.9",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/react-native-nitro-device-info",
    "packages/react-native-nitro-device-integrity",
    "packages/mcp-server",
    "example/showcase",
    "example/benchmark",
    "example/integrity-demo"
  ],
  "resolutions": {
    "qs": "6.16.0",
    "ip-address": "10.7.3",
    "minimatch@^9.0.4": "9.0.7",
    "minimatch@^10.0.1": "10.2.3",
    "minimatch@^10.1.1": "10.2.3",
    "picomatch@^4.0.2": "4.0.4",
    "picomatch@^4.0.3": "4.0.4",
    "ws@^8.18.2": "8.22.0",
    "uuid": "11.1.1",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.7.0",
    "braces@npm:^3.0.3": "patch:braces@npm%3A3.0.3#~/.yarn/patches/braces-npm-3.0.3-582c14023c.patch",
    "argparse@npm:^1.0.7": "2.0.1",
    "http-cache-semantics@npm:^4.1.1": "patch:http-cache-semantics@npm%3A4.3.0#~/.yarn/patches/http-cache-semantics-npm-4.3.0-ee45f76976.patch",
    "http-cache-semantics@npm:4.3.0": "patch:http-cache-semantics@npm%3A4.3.0#~/.yarn/patches/http-cache-semantics-npm-4.3.0-ee45f76976.patch"
  },
  "dependenciesMeta": {
    "@evilmartians/lefthook": {
      "built": true
    }
  },
  "packageManager": "yarn@4.17.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
